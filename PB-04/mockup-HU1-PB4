<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mindzyx — PB-04 | Mensaje Aclaratorio</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#FFFFFF;
    --pink:#FDEAF2;
    --lav:#EDE7FF;
    --cyan:#6ECFD4;
    --cyan-hover:#5ABCC2;
    --text:#2E2E33;
    --muted:#8E91A3;
    --line:#EFE9F5;
    --error:#E85D7A;
    --warning:#F59E0B; /* Añadido para el icono de alerta */
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    font-family:'Inter',Arial,sans-serif;
    background:var(--bg);
    color:var(--text);
    min-height:100vh;
  }
  .bg-blobs{
    position:fixed;inset:0;z-index:-1;overflow:hidden;background:#FFF;
  }
  .blob{position:absolute;border-radius:50%;opacity:0.6}
  .blob-pink{
    width:600px;height:420px;
    background: #FDE0EE;
    top:-90px; left:-110px; border-radius:40% 60% 50% 50%;
  }
  .blob-lav{
    width:600px;height:400px;
    background: #EDE6FF;
    top:-60px; right:-110px; border-radius:60% 40% 55% 45%;
  }
  .header{
    height:60px;display:flex;align-items:center;justify-content:space-between;
    padding:0 20px;max-width:1100px;margin:0 auto;
    border-bottom:1px solid #F0EAF6;
  }
  .logo{
    display:flex;align-items:center;
    cursor: pointer;
  }
  .logo-img{
    height: 44px; 
    width: auto;
    object-fit: contain;
  }
  .nav{ display:flex;gap:18px;align-items:center;font-size:13px;color:var(--muted)}
  .nav a{color:var(--muted);text-decoration:none}
  .nav a.active{color:var(--text);font-weight:600}
  .wrap{
    max-width:680px;margin:0 auto;padding:0 16px 30px;
    text-align: center;
  }
  .btn-primary{
    padding:7px 16px;border-radius:20px;border:none;background:var(--cyan);color:white;font-weight:600;font-size:12px;cursor:pointer;
  }
  
  /* --- ESTILOS DE LA MODAL --- */
  .modal-overlay{
    position:fixed;inset:0;background:rgba(0,0,0,0.35);
    display:none;align-items:center;justify-content:center;padding:16px;z-index:50;
    backdrop-filter: blur(2px); /* Un toque extra para resaltar la modal */
  }
  .modal-overlay.open{ display:flex}
  .modal{
    width:min(450px,100%);background:white;border-radius:16px;padding:24px;box-shadow:0 10px 30px rgba(0,0,0,0.15);text-align:center;
  }
  .modal-icon{
    width:48px;height:48px;border-radius:12px;
    background:#FEF3C7; /* Fondo amarillo suave */
    color:var(--warning);
    display:grid;place-items:center;margin:0 auto 16px;
  }
  .modal h3{font-size:18px;font-weight:700; margin-bottom: 10px; color: var(--text);}
  .modal p{font-size:13px;color:#5A5D72;margin-top:8px; line-height: 1.5; text-align: left;}
  .modal-actions{ display:flex;gap:12px;margin-top:24px}
  
  /* Botones del CU-04 */
  .btn-modal-cancel{
    flex:1;height:42px;border-radius:20px;border:1px solid #DFDAEE;background:white;font-weight:600;cursor:pointer;font-size:13px; color:var(--text);
  }
  .btn-modal-cancel:hover{ background:#F9F7FF; }
  
  .btn-continuar{
    flex:1;height:42px;border-radius:20px;border:none;background:var(--cyan);color:white;font-weight:700;font-size:13px;cursor:pointer;
  }
  .btn-continuar:hover{ background:var(--cyan-hover)}
</style>
</head>
<body>
<div class="bg-blobs">
  <div class="blob blob-pink"></div>
  <div class="blob blob-lav"></div>
</div>

<header class="header">
  <div class="logo">
    <img src="Logo1.png" alt="Mindzyxs Logo" class="logo-img">
  </div>
  <nav class="nav">
    <a href="#" class="active">Inicio</a>
    <a href="#">Nosotros</a>
    <a href="#">Ayuda</a>
  </nav>
  <div style="display:flex;gap:10px; align-items: center;">
    <span style="font-size: 12px; color: var(--muted); font-weight: 600;">Modo Invitado</span>
  </div>
</header>

<main class="wrap" style="margin-top:80px">
  <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 12px;">Panel Principal</h2>
  <p style="font-size: 14px; color: var(--muted); margin-bottom: 24px;">Esta pantalla simula el fondo sobre el cual aparecerá la alerta.</p>
  <button class="btn-primary" id="openModalBtn" style="padding: 10px 24px; font-size: 14px;">Reabrir Aviso Aclaratorio</button>
</main>

<!-- Modal CU-04: Mensaje Aclaratorio (Abierta por defecto) -->
<div class="modal-overlay open" id="avisoModal" role="dialog" aria-modal="true">
  <div class="modal">
    <!-- Icono de información/alerta -->
    <div class="modal-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
    </div>
    
    <h3>Aviso: No diagnóstico</h3>
    
    <p>
      Mindzyx es una herramienta de apoyo y monitoreo emocional. <strong>No reemplaza la atención profesional ni realiza diagnósticos clínicos.</strong>
    </p>
    <p>
      Ante un riesgo alto o urgencia, por favor busca ayuda profesional o comunícate con las líneas de ayuda disponibles en el sistema.
    </p>
    
    <div class="modal-actions">
      <!-- Botones exigidos en el PDF -->
      <button class="btn-modal-cancel" id="cerrarBtn">Cerrar</button>
      <button class="btn-continuar" id="entendidoBtn">Entendido</button>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('avisoModal');
  const cerrarBtn = document.getElementById('cerrarBtn');
  const entendidoBtn = document.getElementById('entendidoBtn');
  const openModalBtn = document.getElementById('openModalBtn');

  // Función para cerrar la modal
  const closeModal = () => modal.classList.remove('open');

  // Eventos de los botones
  cerrarBtn.addEventListener('click', closeModal);
  entendidoBtn.addEventListener('click', closeModal);
  
  // Para propósitos de demostración, poder volver a abrirla
  openModalBtn.addEventListener('click', () => modal.classList.add('open'));

  // Cerrar al hacer clic fuera del contenido de la modal
  modal.addEventListener('click', (e) => { 
    if(e.target === modal) closeModal();
  });
</script>
</body>
</html>
